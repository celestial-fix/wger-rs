# Required: URL for an existing wger PostgreSQL database (do not add migrations).
DATABASE_URL=

# Public base URL and timezone for the instance.
SITE_URL=
TIME_ZONE=Etc/UTC

# RSA JWK values used for allauth-headless and PowerSync tokens.
# Leave blank here; supply your own matching private/public key pair.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Optional runtime settings (defaults are shown).
BIND=0.0.0.0:8000
STATIC_ROOT=/static
MEDIA_ROOT=/media
POWERSYNC_URL=
POWERSYNC_URL_PATH=ps
# Internal proxy destinations. Leave unset to answer 502 on those routes.
DJANGO_UI_URL=
POWERSYNC_UPSTREAM_URL=
# Comma-separated IPs, CIDRs, and hostnames allowed to set X-Forwarded-*.
TRUSTED_PROXIES=
POWERSYNC_TOKEN_LIFETIME=600
JWT_ACCESS_TOKEN_LIFETIME=300
JWT_REFRESH_TOKEN_LIFETIME=86400
MIN_ACCOUNT_AGE_TO_TRUST=21
WGER_VERSION=2.7.0
MIN_APP_VERSION=2.1.0
MIN_SERVER_VERSION=2.5.0
